# Application Settings
APP_NAME="WhiteJersey Cafe POS"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Host Port Configuration
APP_PORT=8080

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wj_cafe
DB_USERNAME=wj_cafe_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Laravel Defaults
LOG_CHANNEL=stack
LOG_LEVEL=debug

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

VITE_APP_NAME="${APP_NAME}"
